{
  "manifest_version": 3,
  "name": "DICIDY Flow Automation Bridge",
  "version": "0.1.3",
  "description": "Local bridge for DICIDY automation using the existing Chrome session.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DICIDY Flow Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
